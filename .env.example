# Backend port
PORT=3000

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false   # use 'true' if you use port 465
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-gmail-app-password

# Email routing
FROM_EMAIL=your-email@example.com     # must match your Gmail
TO_EMAIL=your-email@example.com       # your receiving email

# Admin credentials for your backend admin UI
ADMIN_USER=replace-with-admin-username
ADMIN_PASS=replace-with-a-strong-password
